{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tneb-power-cut",
  "main": "./_worker.js/index.js",
  "compatibility_date": "2026-09-02",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/_serverFn/*"]
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
